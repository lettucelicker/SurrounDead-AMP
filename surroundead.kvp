Meta.DisplayName=SurrounDead Multiplayer Server
Meta.Description=Experimental SurrounDead multiplayer host using UE4SS and Wine
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=lettucelicker
Meta.URL=https://store.steampowered.com/app/1645820/SurrounDead/
Meta.DisplayImageSource=steam:1645820
Meta.EndpointURIFormat=
Meta.ConfigManifest=surroundeadconfig.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=surroundead.kvp
Meta.MinAMPVersion=2.6.0.4
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=SurrounDead is a Windows application and requires Wine and Xvfb to run on Linux.
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.AppConfigId=9448acb3-5820-48d3-bda0-8ff4f75a73ab
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False

App.DisplayName=SurrounDead Multiplayer Server
App.RootDir=./surroundead/
App.BaseDirectory=./surroundead/server/
App.SteamWorkshopDownloadLocation=

App.ExecutableWin=server\SurrounDead.exe
App.ExecutableLinux=/usr/bin/xvfb-run
App.WorkingDir=server

App.LinuxCommandLineArgs=-a wine "./SurrounDead.exe"
App.WindowsCommandLineArgs=
App.CommandLineArgs=-nosound -NoSplash -dx11 -windowed -ResX=640 -ResY=480 -port={{$ServerPort}}

App.UseLinuxIOREDIR=False

App.AppSettings={}

App.EnvironmentVariables={"SteamAppId":"1645820","SteamGameId":"1645820","WINEPREFIX":"{{$FullRootDir}}.wine","WINEARCH":"win64","WINEDEBUG":"-all","WINEDLLOVERRIDES":"dwmapi=n,b"}

App.CommandLineParameterFormat=-{0} "{1}"
App.CommandLineParameterDelimiter=

App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=
App.ExitFile=app_exit.lck

App.HasWriteableConsole=False
App.HasReadableConsole=True

App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=

App.ApplicationIPBinding=0.0.0.0

App.Ports=@IncludeJson[surroundeadports.json]

App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=ServerPort
App.UniversalSleepSteamQueryPortRef=0

App.MaxUsers=8

App.UseRandomAdminPassword=False
App.RemoteAdminPassword=

App.AdminMethod=STDIO
App.AdminLoginTransform=None

App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=

App.TelnetLoginFormat={0}

App.UpdateSources=[]

App.Compatibility=None

App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False

App.MonitorChildProcessName=^.*SurrounDead-Win64-Shipping\.exe.*$
App.MonitorDirectChildOnly=False

App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=Immediate

App.TailLogFilePath=SurrounDead/Binaries/Win64/UE4SS.log

Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}

Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
